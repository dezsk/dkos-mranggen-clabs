		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-save tokens from login responses",
					"if (pm.response.code === 200 && pm.request.url.toString().includes('/api/auth/login')) {",
					"    var jsonData = pm.response.json();",
					"    if (jsonData.token) {",
					"        // Check if admin or user login",
					"        if (pm.request.url.toString().includes('admin')) {",
					"            pm.collectionVariables.set('adminToken', jsonData.token);",
					"            console.log('Admin token saved');",
					"        } else {",
					"            pm.collectionVariables.set('userToken', jsonData.token);",
					"            console.log('User token saved');",
					"        }",
					"    }",
					"}",
					"",
					"// Save kost ID from create kost response",
					"if (pm.response.code === 201 && pm.request.url.toString().includes('/api/admin/kosts')) {",
					"    var jsonData = pm.response.json();",
					"    if (jsonData._id) {",
					"        pm.collectionVariables.set('kostId', jsonData._id);",
					"        console.log('Kost ID saved: ' + jsonData._id);",
					"    }",
					"}"
				]
			}
		}
	],
